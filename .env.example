# MongoDB Connection String (Local MongoDB or MongoDB Atlas URI)
# Example Local: mongodb://localhost:27017/llm_forensic
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/llm_forensic?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/llm_forensic

# Groq API Key (get from https://console.groq.com)
GROQ_API_KEY=
# Optional: Model name (defaults to openai/gpt-oss-120b)
GROQ_MODEL=openai/gpt-oss-120b


# Secret key for signing JWT tokens (use a long random string in production)
JWT_SECRET=dev-jwt-secret-key-change-in-production-12345

# Backend Port
BACKEND_PORT=8000

# Optional: SMTP Configuration for Email Verification (e.g. Gmail App Password)
SMTP_EMAIL=
SMTP_PASSWORD=
